# proxy-api .env template
# Copy to .env and fill in.  All gitignored — never commit .env.

# ─── Network ──────────────────────────────────────────────────────────
BIND_HOST=127.0.0.1
HOST_PORT=8080

# ─── Postgres ─────────────────────────────────────────────────────────
POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace_me

# ─── sub2api ──────────────────────────────────────────────────────────
# Runtime mode: release | debug
SERVER_MODE=release
# Functional mode: standard (full SaaS — billing/quota) | simple (private use, skip billing)
RUN_MODE=standard
TZ=Asia/Shanghai

# Generate: openssl rand -hex 32
JWT_SECRET=replace_me
TOTP_ENCRYPTION_KEY=replace_me

# Optional: seed admin on first boot. Leave password blank to auto-generate
# (printed in container logs on first run).
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────
# Empty = no auth (fine for single-host dev). Set for multi-host / public.
REDIS_PASSWORD=

# ─── Outbound HTTP proxy ──────────────────────────────────────────────
# The sub2api container forwards requests to Antigravity / Anthropic /
# Google through this proxy. Use `host.docker.internal:<port>` to reach
# a proxy running on the host (Clash / mihomo / V2Ray etc.).
# Leave empty (commented) if your host has direct outbound access.
OUTBOUND_PROXY=http://host.docker.internal:7897

# ─── Antigravity gateway ──────────────────────────────────────────────
# 'prod' = public stable endpoint, 'daily' = internal preview channel
GATEWAY_ANTIGRAVITY_FORWARD_BASE_URL=prod

# ─── cursor2api (Phase 1+, only when using docker-compose.override.yml) ─
# Cursor session token (extract from Cursor app keychain / DevTools).
# CURSOR_TOKEN=
# API key cursor2api requires from sub2api (you make this up).
# CURSOR2API_KEY=
