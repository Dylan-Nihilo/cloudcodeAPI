# proxy-api PRODUCTION .env template
# Copy to .env on the server, then fill in EVERY value below.
# All gitignored — never commit .env.

# ─── Domain + TLS ─────────────────────────────────────────────────────
# DOMAIN can be either:
#   - A real hostname (e.g. api.example.com) — you also need to:
#       1. Point its DNS A record at this server
#       2. EDIT Caddyfile, REMOVE the line `tls internal` to enable
#          auto Let's Encrypt
#   - A raw IP (e.g. 49.51.187.129) — Caddy uses self-signed TLS;
#     browsers warn on first visit. Fine for closed-group testing.
DOMAIN=49.51.187.129
# Email Let's Encrypt uses (only relevant when you switch to a real domain).
ACME_EMAIL=you@example.com

# ─── Registry image ──────────────────────────────────────────────────
# GitHub Actions publishes the production image to GHCR.
# Keep this lowercase even if the GitHub repo contains uppercase letters.
SUB2API_IMAGE=ghcr.io/dylan-nihilo/cloudcodeapi:main
# Optional: only needed when the GHCR package is private.
GHCR_USERNAME=
GHCR_TOKEN=

# ─── Postgres ─────────────────────────────────────────────────────────
POSTGRES_DB=sub2api
POSTGRES_USER=sub2api
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace_me

# ─── sub2api ──────────────────────────────────────────────────────────
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# Generate each: openssl rand -hex 32
JWT_SECRET=replace_me
TOTP_ENCRYPTION_KEY=replace_me

# Admin account auto-created on first boot. Use a real email; pick a
# strong password — this is the brand owner login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me_with_a_strong_password

# Antigravity gateway endpoint. 'prod' is the public-stable channel.
GATEWAY_ANTIGRAVITY_FORWARD_BASE_URL=prod
ANTIGRAVITY_OAUTH_CLIENT_ID=replace_me
ANTIGRAVITY_OAUTH_CLIENT_SECRET=replace_me
GEMINI_CLI_OAUTH_CLIENT_ID=replace_me
GEMINI_CLI_OAUTH_CLIENT_SECRET=replace_me

# ─── Redis ────────────────────────────────────────────────────────────
# Empty for single-host. Set if you ever expose redis.
REDIS_PASSWORD=
